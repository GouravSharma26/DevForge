{
  "name": "@devforge/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build --workspace=@devforge/database",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate --schema=../../packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@devforge/database": "*",
    "@devforge/shared-types": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.14.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.7.0",
    "cookie": "^0.7.2",
    "dotenv": "^16.4.0",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "prisma": "^7.10.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie": "^0.6.0",
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.11.0",
    "typescript": "~5.9.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
