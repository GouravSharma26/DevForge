generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ExperienceLevel {
  BEGINNER
  MID
  SENIOR
}

model User {
  id              String          @id @default(cuid())
  username        String          @unique
  email           String          @unique
  password        String
  avatar          String?
  bio             String?
  targetRole      String?
  experienceLevel ExperienceLevel @default(BEGINNER)
  role            Role            @default(USER)
  xp              Int             @default(0)
  streak          Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  aiRequestCount  Int             @default(0)
  lastAiRequestAt DateTime?
  enrollments     Enrollment[]
  progress        UserProgress[]
  submissions     Submission[]
  matchesAsP1     Match[]         @relation("player1")
  matchesAsP2     Match[]         @relation("player2")
  matchesWon      Match[]         @relation("winner")
  resume          Resume[]
  interviews      Interview[]
  jdMatches       JDMatch[]
  resumeBuilder   ResumeBuilder?
}

model Article {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String   @unique
  imageUrl    String?
  source      String
  category    String   @default("general")
  publishedAt DateTime
  createdAt   DateTime @default(now())
}

model LearningPath {
  id          String       @id @default(cuid())
  title       String
  description String
  icon        String       @default("📚")
  level       ExperienceLevel @default(BEGINNER)
  totalTopics Int          @default(0)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  topics      Topic[]
  enrollments Enrollment[]
}

model Topic {
  id             String       @id @default(cuid())
  title          String
  description    String?
  videoUrl       String?
  order          Int
  estimatedMins  Int          @default(30)
  pathId         String
  path           LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  progress       UserProgress[]
}

model Enrollment {
  id        String       @id @default(cuid())
  userId    String
  pathId    String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId])
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  topicId     String
  completed   Boolean  @default(false)
  completedAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Problem {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String
  difficulty  Difficulty   @default(EASY)
  category    String
  examples    Json
  constraints String[]
  starterCode Json         // { javascript: "...", python: "..." }
  testCases   Json         // [{ input: "...", expected: "..." }]
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  submissions Submission[]
  matches     Match[]
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  code      String
  language  String
  status    String   // "accepted", "wrong_answer", "runtime_error"
  runtime   Int?     // ms
  memory    Int?     // KB
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

enum MatchStatus {
  WAITING
  ACTIVE
  COMPLETED
}

model Match {
  id         String      @id @default(cuid())
  status     MatchStatus @default(WAITING)
  problemId  String
  player1Id  String
  player2Id  String?
  winnerId   String?
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime    @default(now())
  problem    Problem     @relation(fields: [problemId], references: [id])
  player1    User        @relation("player1", fields: [player1Id], references: [id])
  player2    User?       @relation("player2", fields: [player2Id], references: [id])
  winner     User?       @relation("winner", fields: [winnerId], references: [id])
  isFriendly Boolean     @default(false)
}

model Resume {
  id              String      @id @default(cuid())
  userId          String      
  profileName     String      @default("Default")
  originalText    String      
  contentHash     String?
  skills          String[]
  experienceLevel String      @default("JUNIOR")
  targetRole      String?
  score           Int         @default(0)
  skillsScore     Int         @default(0)
  projectsScore   Int         @default(0)
  writingScore    Int         @default(0)
  atsScore        Int         @default(0)
  suggestions     Json
  gaps            String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews      Interview[]
  jdMatches       JDMatch[]

  @@index([userId])
}

model JDMatch {
  id              String   @id @default(cuid())
  userId          String
  resumeId        String
  companyName     String   @default("Unknown Company")
  jobTitle        String   @default("Untitled Role")
  jdText          String
  jdHash          String?
  matchScore      Int
  matchedKeywords String[]
  missingKeywords String[]
  cultureFlags    Json     @default("[]")
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume          Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model ResumeBuilder {
  id        String   @id @default(cuid())
  userId    String   @unique
  sections  Json
  template  String   @default("modern")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Interview {
  id        String            @id @default(cuid())
  userId    String
  resumeId  String
  status    InterviewStatus   @default(IN_PROGRESS)
  score     Int?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume    Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Question {
  id             String    @id @default(cuid())
  interviewId    String
  round          Int
  question       String
  context        String?
  userAnswer     String?
  feedback       String?
  score          Int?
  
  // -- NEW FIELDS FOR GRANDMASTER --
  isGrandmaster  Boolean   @default(false)
  language       String?
  buggyCode      String?
  expectedOutput String?
  pistonOutput   String?
  runAttempts    Int       @default(0)

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
}

model SystemConfig {
  id               String   @id @default("global") 
  botEnabled       Boolean  @default(true)
  botQueueWaitTime Int      @default(10) 
  
  // Base Problem Times
  baseTimeEasy     Int      @default(120)
  baseTimeMedium   Int      @default(300)
  baseTimeHard     Int      @default(600)
  
  // Bot Skill Multipliers
  multBeginner     Float    @default(1.8)
  multIntermediate Float    @default(1.0)
  multGrandmaster  Float    @default(0.4)
  
  variancePercent  Float    @default(0.20)
  updatedAt        DateTime @updatedAt
}

